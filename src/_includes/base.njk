<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nom }}</title>
  <meta name="description" content="{{ resume or site.description }}">
  <meta property="og:title" content="{{ title or site.nom }}">
  <meta property="og:description" content="{{ resume or site.description }}">
  <meta property="og:type" content="{% if rubrique %}article{% else %}website{% endif %}">
  <meta name="theme-color" content="#292C6D">
  <link rel="icon" href="/images/icone.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="evitement" href="#principal">Aller au contenu</a>
  <header class="entete">
    <div class="enveloppe">
      <nav class="barre" aria-label="Navigation principale">
        <a class="logo" href="/">
          <strong>{{ site.nom }}</strong>
          <span>{{ site.slogan }}</span>
        </a>
        <ul class="menu">
          <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Accueil</a></li>
          <li><a href="/#portraits"{% if rubrique == "Ceux qui font le bloc" %} aria-current="page"{% endif %}>Ceux qui font le bloc</a></li>
          <li><a href="/#refaire"{% if rubrique == "Si c'était à refaire" %} aria-current="page"{% endif %}>Si c'était à refaire</a></li>
          <li><a href="/#premiere-fois"{% if rubrique == "La première fois où j'ai…" %} aria-current="page"{% endif %}>La première fois</a></li>
          <li><a href="/#apropos">À propos</a></li>
        </ul>
      </nav>
      {% block entete %}{% endblock %}
    </div>
  </header>

  <main id="principal">
    {% block principal %}{% endblock %}
  </main>

  <footer class="pied">
    <div class="enveloppe">
      <span>{{ site.nom }} · {{ site.slogan }}{% if site.instagram %} · <a href="{{ site.instagram }}" rel="me">Instagram</a>{% endif %}</span>
      <span>{{ site.avertissement }}</span>
    </div>
  </footer>
  {% block scripts %}{% endblock %}
  {%- if site.goatcounter and not montrerBrouillons %}
  {#- Mesure d'audience GoatCounter : sans cookies, désactivée pendant l'aperçu (npm start) #}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  {%- if site.compteur_visible %}
  <script>
    // Nombre de lectures de l'article, affiché à la suite des infos sous le titre
    (function () {
      var zone = document.querySelector(".lectures");
      if (!zone) return;
      fetch("https://{{ site.goatcounter }}.goatcounter.com/counter/" + encodeURIComponent(location.pathname) + ".json")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.count) return;
          var n = String(d.count).replace(/[^0-9]/g, "");
          if (!n || n === "0") return;
          zone.textContent = " · " + Number(n).toLocaleString("fr-FR") + (n === "1" ? " lecture" : " lectures");
          zone.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
  {%- endif %}
  {%- endif %}
</body>
</html>
