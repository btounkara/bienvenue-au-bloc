{% extends "base.njk" %}

{% block principal %}
<article class="article">
  <div class="enveloppe">
    <a class="retour" href="/#portraits">← Tous les portraits</a>
    <header>
      <span class="meta">Ceux qui font le bloc{% if brouillon %} <span class="badge">Brouillon</span>{% endif %}</span>
      <h1>{{ title }}</h1>
      <p class="infos">{% if prenom %}{{ prenom }}{% endif %}{% if metier %}, {{ metier }}{% endif %} · <time datetime="{{ page.date | dateIso }}">{{ page.date | dateFr }}</time>{% if duree %} · {{ duree }} min{% if youtube %} de vidéo{% else %} d'écoute{% endif %}{% endif %}</p>
    </header>

    {% set attente = "La vidéo ou l'audio apparaîtra ici dès que le lien YouTube ou Spotify sera ajouté." %}
    {% include "media.njk" %}

    <div class="texte">
      {% if image %}
      <figure class="couverture"><img src="{{ image }}" alt="{% if prenom %}{{ prenom }}{% endif %}"></figure>
      {% endif %}

      {% if content | texteBrut %}
      <h2>{% if prenom %}{{ prenom }} en quelques mots{% else %}Son parcours{% endif %}</h2>
      {{ content | safe }}
      {% endif %}

      {% if moments and moments.length %}
      <h2>Les moments clés</h2>
      <ol class="moments">
        {% for m in moments %}
        <li><span class="temps">{{ m.temps }}</span><span>{{ m.sujet }}</span></li>
        {% endfor %}
      </ol>
      {% endif %}

      {% if citations and citations.length %}
      <h2>Les phrases à retenir</h2>
      <div class="citations">
        {% for c in citations %}
        <figure class="citation"><blockquote>{{ c }}</blockquote></figure>
        {% endfor %}
      </div>
      {% endif %}

      <p class="liens-episode">
        {% if youtube %}<a href="{{ youtube }}">Voir sur YouTube</a>{% endif %}
        {% if spotify %}<a href="{{ spotify }}">Écouter sur Spotify</a>{% endif %}
        {% if instagram %}<a href="{{ instagram }}">Voir la publication Instagram</a>{% endif %}
      </p>
    </div>

    {% include "voisins.njk" %}
  </div>
</article>
{% endblock %}
