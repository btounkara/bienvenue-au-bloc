{#- Dessins utilisés quand une publication n'a pas d'image -#}
{%- macro dessin(rubrique) -%}
{%- if rubrique == "Ceux qui font le bloc" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="38" y="14" width="24" height="44" rx="12" fill="#FFD1D1"/><path d="M28 46c0 12 10 22 22 22s22-10 22-22M50 68v16M38 86h24"/><path d="M44 30h12M44 40h12"/></svg>
{%- elif rubrique == "La première fois où j'ai…" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M50 88V46"/><path d="M50 58c-4-14-16-22-30-20 2 14 14 22 30 20z" fill="#FFD1D1"/><path d="M50 48c2-16 14-26 30-26-1 16-13 26-30 26z" fill="#E07A84" stroke="#292C6D"/><path d="M34 88h32"/></svg>
{%- else -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M50 14L88 82H12z" fill="#FFD1D1"/><path d="M50 40v20"/><circle cx="50" cy="70" r="2.5" fill="#292C6D"/></svg>
{%- endif -%}
{%- endmacro -%}

{%- macro carte(p, enUne) -%}
<article class="carte{% if enUne %} une{% endif %}{% if p.data.rubrique == 'Ceux qui font le bloc' %} carte-portrait{% elif p.data.rubrique == "Si c'était à refaire" %} carte-erreur{% else %} carte-premiere{% endif %}" data-theme="{{ p.data.rubrique }}" data-url="{{ p.url }}">
  <a href="{{ p.url }}">
    <div class="illus{% if p.data.image %} photo{% endif %}">
      {%- if p.data.image %}
      <img src="{{ p.data.image }}" alt="" loading="lazy">
      {%- else %}
      {{ dessin(p.data.rubrique) }}
      {%- endif %}
    </div>
    <div class="corps">
      <span class="meta">{{ p.data.rubrique }}{% if p.data.metier %} · {{ p.data.metier }}{% endif %}{% if p.data.brouillon %} <span class="badge">Brouillon</span>{% endif %}</span>
      <h3>{{ p.data.title }}</h3>
      <p>{{ p.data.resume }}</p>
      <span class="duree">{{ p.date | dateFr }}{% if p.data.duree %} · {{ p.data.duree }} min d'écoute{% endif %}</span>
    </div>
  </a>
</article>
{%- endmacro -%}
