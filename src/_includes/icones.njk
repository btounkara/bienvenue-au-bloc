{%- macro icone(nom) -%}
{%- if nom == "hygiene" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M30 88V52c0-4 3-6 6-6s6 2 6 6v-30c0-4 3-6 6-6s6 2 6 6v26-30c0-4 3-6 6-6s6 2 6 6v34-22c0-4 3-6 6-6s6 2 6 6v44c0 14-10 24-24 24H54c-12 0-24-8-24-12z" fill="#FFD1D1"/></svg>
{%- elif nom == "materiel" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" aria-hidden="true"><circle cx="30" cy="78" r="10" fill="#FFD1D1"/><circle cx="56" cy="80" r="10" fill="#FFD1D1"/><path d="M37 71l40-58M49 73L33 12"/><circle cx="44" cy="58" r="2.5" fill="#292C6D"/></svg>
{%- elif nom == "chirurgies" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 82l40-40" stroke-width="7"/><path d="M58 42l6-6c10-10 20-14 22-12s-2 12-12 22l-10 10z" fill="#FFD1D1"/><path d="M58 42l6 6"/></svg>
{%- elif nom == "equipe" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" aria-hidden="true"><circle cx="34" cy="38" r="11" fill="#FFD1D1"/><circle cx="66" cy="38" r="11" fill="#E07A84" stroke="none"/><path d="M14 82c2-14 10-22 20-22s18 8 20 22M46 82c2-14 10-22 20-22s18 8 20 22"/></svg>
{%- elif nom == "organisation" -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="16" y="22" width="68" height="62" rx="4" fill="#FFD1D1"/><path d="M16 38h68M34 14v14M66 14v14"/><rect x="28" y="48" width="12" height="10" fill="#E07A84" stroke="none"/><path d="M48 53h24M28 70h44"/></svg>
{%- else -%}
<svg viewBox="0 0 100 100" fill="none" stroke="#292C6D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="24" y="16" width="52" height="70" rx="4" fill="#FFD1D1"/><path d="M34 36l5 5 9-10M34 56l5 5 9-10M56 37h12M56 57h12M34 74h34"/></svg>
{%- endif -%}
{%- endmacro -%}

{#- Retrouve l'icône d'une catégorie à partir de son nom -#}
{%- macro iconeCategorie(nomCategorie, categories) -%}
{%- set trouve = "securite" -%}
{%- for c in categories -%}{%- if c.nom == nomCategorie -%}{%- set trouve = c.icone -%}{%- endif -%}{%- endfor -%}
{{ icone(trouve) }}
{%- endmacro -%}
