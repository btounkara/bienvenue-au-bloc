---
permalink: /
---
{% extends "base.njk" %}
{% from "cartes.njk" import carte %}

{% block entete %}
<div class="accroche">
  <figure class="banniere">
    <img src="{{ site.banniere }}" width="1400" height="788" alt="Illustration d'une salle d'opération : scialytique, table d'opération et table d'instruments, avec le titre BienvenueAuBloc.">
  </figure>
  <div class="accroche-texte">
    <h1>{{ site.accroche_titre | motsEnCouleur | safe }}</h1>
    <div>
      <p>{{ site.accroche_texte }}</p>
      <span class="etiquette">{{ site.accroche_signature }}</span>
    </div>
  </div>
</div>
{% endblock %}

{% block principal %}
{% set total = collections.publications.length %}
<section id="publications">
  <span id="portraits" class="ancre"></span><span id="refaire" class="ancre"></span><span id="premiere-fois" class="ancre"></span>
  <div class="enveloppe">
    <div class="rubriques">
      <a class="rubrique" href="#portraits" data-filtre="Ceux qui font le bloc">
        <strong>Ceux qui font le bloc</strong>
        <span>Des professionnels du bloc racontent leur métier, en audio.</span>
        <em>{{ collections.portraits.length }} portrait{% if collections.portraits.length > 1 %}s{% endif %}</em>
      </a>
      <a class="rubrique" href="#refaire" data-filtre="Si c'était à refaire">
        <strong>Si c'était à refaire</strong>
        <span>Une collègue raconte anonymement une situation qu'elle vivrait autrement aujourd'hui, pour que d'autres en profitent.</span>
        <em>{{ collections.erreurs.length }} retour{% if collections.erreurs.length > 1 %}s{% endif %} d'expérience</em>
      </a>
      <a class="rubrique" href="#premiere-fois" data-filtre="La première fois où j'ai…">
        <strong>La première fois où j'ai…</strong>
        <span>Des professionnels racontent une première fois au bloc, ce qu'ils ont ressenti et ce qu'ils ont changé depuis.</span>
        <em>{{ collections.premieresFois.length }} témoignage{% if collections.premieresFois.length > 1 %}s{% endif %}</em>
      </a>
    </div>

    <div class="titre-section">
      <h2>Dernières publications</h2>
      <p id="compteur">{{ total }} publication{% if total > 1 %}s{% endif %}</p>
    </div>

    {% if total %}
    <div class="recherche">
      <label for="champ-recherche">Rechercher</label>
      <div class="champ">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
        <input type="search" id="champ-recherche" placeholder="Ex. : IADE, instrumentiste, compresses…" autocomplete="off">
      </div>
    </div>

    <div class="themes" role="group" aria-label="Filtrer par rubrique" id="themes">
      <button type="button" aria-pressed="true" data-theme="Tous">Tout</button>
      <button type="button" aria-pressed="false" data-theme="Ceux qui font le bloc">Ceux qui font le bloc</button>
      <button type="button" aria-pressed="false" data-theme="Si c'était à refaire">Si c'était à refaire</button>
      <button type="button" aria-pressed="false" data-theme="La première fois où j'ai…">La première fois où j'ai…</button>
    </div>
    {% endif %}

    <div class="grille" id="grille" data-index="{{ '/recherche.json' | htmlBaseUrl }}">
      {%- for p in collections.publications %}
      {{ carte(p, loop.first) }}
      {%- endfor %}
    </div>
    <p class="vide" id="vide"{% if total %} hidden{% endif %}>Le premier portrait arrive très bientôt. Suivez le blog sur Instagram pour ne pas le manquer.</p>
  </div>
</section>

<section class="participer" id="participer">
  <div class="enveloppe">
    <h2>{{ site.participer_titre }}</h2>
    <p>{{ site.participer_texte }}</p>
    {% if site.email or site.instagram %}
    <div class="contacts">
      {% if site.instagram %}<a class="bouton" href="{{ site.instagram }}">Me contacter sur Instagram</a>{% endif %}
      {% if site.email %}<span class="courriel">Par e-mail : <a href="mailto:{{ site.email }}">{{ site.email }}</a></span>{% endif %}
    </div>
    {% endif %}
  </div>
</section>

<section class="apropos" id="apropos">
  <div class="enveloppe">
    <figure class="portrait">
      <img src="{{ site.portrait }}" loading="lazy" alt="Illustration d'une IBODE en tenue de bloc, calot fleuri, masque et lunettes, à la table d'instruments.">
    </figure>
    <div>
      <h2>{{ site.presentation_titre }}</h2>
      <div class="presentation">{{ site.presentation | safe }}</div>
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/assets/recherche.js" defer></script>
{% endblock %}
